# ===== للـ Selfbot =====
# USER_TOKEN هو توكن حسابك الشخصي (ليس bot token!)
# ⚠️ تحذير: استخدام selfbot يخالف Terms of Service من Discord
USER_TOKEN=your_user_token_here

# ===== للـ Bot العادي =====
DISCORD_TOKEN=your_bot_token_here
APPLICATION_ID=your_application_id_here

# ===== قاعدة البيانات =====
DATABASE_URL=mysql://root:password@127.0.0.1:3306/discord_bot_shield_db

# ===== اختياري - للتطوير =====
GUILD_ID=your_test_server_id
RUST_LOG=info
